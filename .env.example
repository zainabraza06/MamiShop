# ─────────────────────────────────────────────────────────────
# MomiShop environment contract
# Copy to `.env.local` for development. Never commit real values.
# Every variable is validated at boot by src/lib/env.ts — the app
# refuses to start in production if a required secret is missing.
# Only NEXT_PUBLIC_* values are ever exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MomiShop
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR
NEXT_PUBLIC_DEFAULT_LOCALE=en-PK

# ── Database (PostgreSQL) ─────────────────────────────────────
# Pooled connection used by the app (PgBouncer / Neon pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momishop?schema=public&connection_limit=10"
# Direct connection used by `prisma migrate` (bypasses the pooler).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/momishop?schema=public"
# Disposable database used by `npm run db:check-drift`. Prisma WIPES this
# database to replay migrations into it, so it must never be DATABASE_URL — the
# check script refuses to run if it is. Create it once with:
#   docker exec momishop-postgres psql -U postgres -c "CREATE DATABASE momishop_shadow;"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momishop_shadow"

# ── Auth (NextAuth / Auth.js v5) ──────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Redis (Upstash REST). Optional in dev: falls back to in-memory. ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments: Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Payments: JazzCash (Pakistan) ─────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/api/payments/jazzcash/callback
JAZZCASH_ENV=sandbox

# ── Payments: Easypaisa (Pakistan) ────────────────────────────
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/api/payments/easypaisa/callback
EASYPAISA_ENV=sandbox

# ── Media storage: Cloudinary ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Transactional email: Resend ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="MomiShop <orders@momishop.pk>"
EMAIL_REPLY_TO=support@momishop.pk

# ── SMS: Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Background jobs (Vercel Cron hits /api/cron/*) ────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ── Analytics ─────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Feature flags ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_LOYALTY=false
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true

# ── Seeding (development / staging only) ──────────────────────
SEED_ADMIN_EMAIL=admin@momishop.pk
SEED_ADMIN_PASSWORD=ChangeMe!2024
