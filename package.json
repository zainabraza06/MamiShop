{
  "name": "momishop",
  "version": "1.0.0",
  "private": true,
  "description": "MomiShop — made-to-measure modest fashion e-commerce platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @momishop/backend",
    "dev:web": "npm run dev -w @momishop/frontend",
    "build": "npm run build -w @momishop/backend && npm run build -w @momishop/frontend",
    "build:api": "npm run build -w @momishop/backend",
    "build:web": "npm run build -w @momishop/frontend",
    "start:api": "npm run start -w @momishop/backend",
    "start:web": "npm run start -w @momishop/frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:e2e": "npm run test:e2e -w @momishop/frontend --",
    "db:generate": "npm run db:generate -w @momishop/backend",
    "db:migrate": "npm run db:migrate -w @momishop/backend",
    "db:deploy": "npm run db:deploy -w @momishop/backend",
    "db:studio": "npm run db:studio -w @momishop/backend",
    "db:seed": "npm run db:seed -w @momishop/backend",
    "db:reset": "npm run db:reset -w @momishop/backend",
    "db:check-drift": "npm run db:check-drift -w @momishop/backend",
    "gen:images": "npm run gen:images -w @momishop/frontend",
    "load:smoke": "k6 run loadtest/smoke.js",
    "load:browse": "k6 run loadtest/browse.js",
    "prepare": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
